<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_cycle_user_task" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="boundary-cycle-user-task" name="Reminder cycle on a user task" isExecutable="true">
    <bpmn:startEvent id="start">
      <bpmn:outgoing>toApprove</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="approve" name="Approve">
      <bpmn:incoming>toApprove</bpmn:incoming>
      <bpmn:outgoing>toDone</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="done">
      <bpmn:incoming>toDone</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="remindTimer" name="Reminder cycle" cancelActivity="false" attachedToRef="approve">
      <bpmn:outgoing>toReminded</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">=cycle</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:endEvent id="reminded">
      <bpmn:incoming>toReminded</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="toApprove" sourceRef="start" targetRef="approve" />
    <bpmn:sequenceFlow id="toDone" sourceRef="approve" targetRef="done" />
    <bpmn:sequenceFlow id="toReminded" sourceRef="remindTimer" targetRef="reminded" />
  </bpmn:process>
</bpmn:definitions>
