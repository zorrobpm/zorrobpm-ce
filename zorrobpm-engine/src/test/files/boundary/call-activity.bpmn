<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definitions_boundary_call_activity" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="boundary-call-activity" name="Timer on a call activity" isExecutable="true">
    <bpmn:startEvent id="start">
      <bpmn:outgoing>toCall</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:callActivity id="call" name="Call">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="boundary-child" propagateAllChildVariables="false" />
      </bpmn:extensionElements>
      <bpmn:incoming>toCall</bpmn:incoming>
      <bpmn:outgoing>toDone</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:endEvent id="done">
      <bpmn:incoming>toDone</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="callTimeout" name="1 hour" attachedToRef="call">
      <bpmn:outgoing>toTimedOut</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT1H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:endEvent id="timedOut">
      <bpmn:incoming>toTimedOut</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="toCall" sourceRef="start" targetRef="call" />
    <bpmn:sequenceFlow id="toDone" sourceRef="call" targetRef="done" />
    <bpmn:sequenceFlow id="toTimedOut" sourceRef="callTimeout" targetRef="timedOut" />
  </bpmn:process>
</bpmn:definitions>
