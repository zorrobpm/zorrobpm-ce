<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definitions_retry-service-task-none" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="lock-test" name="Retries of a service task" isExecutable="true">
    <bpmn:startEvent id="start">
      <bpmn:outgoing>toCharge</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="charge" name="Charge">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="lock-test" />
      </bpmn:extensionElements>
      <bpmn:incoming>toCharge</bpmn:incoming>
      <bpmn:outgoing>toDone</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="done">
      <bpmn:incoming>toDone</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="toCharge" sourceRef="start" targetRef="charge" />
    <bpmn:sequenceFlow id="toDone" sourceRef="charge" targetRef="done" />
  </bpmn:process>
</bpmn:definitions>
